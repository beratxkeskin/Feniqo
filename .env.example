# MoneyMate - Environment Variables Configuration

# Supabase Credentials (Required for Cloud Database mode)
# If left blank, the application will run in fully featured LocalStorage "Demo Mode" automatically.

# Vite configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Alternative Vercel/Next.js compatible keys (MoneyMate code supports both!)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
